# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 透過 ngrok / 正式網域存取時填入，逗號分隔，例如 https://xxxx.ngrok-free.app
DJANGO_CSRF_TRUSTED_ORIGINS=
# 位於 Nginx / ngrok / cloudflared 等反向代理後方時設為 True
DJANGO_BEHIND_PROXY=False

# PostgreSQL：有 DATABASE_URL 時優先使用（例如 Neon：postgres://user:pass@host/db?sslmode=require），否則讀下列 DB_*
DATABASE_URL=
DB_NAME=line_liff
DB_USER=line_liff
DB_PASSWORD=line_liff
DB_HOST=localhost
DB_PORT=5432

# LINE MINI App channel
LIFF_ID=
# MINI App channel 的 Channel ID（即 LIFF ID 中 "-" 前面的數字），用於驗證 ID token 的 aud
LINE_CHANNEL_ID=

# Messaging API channel（Basic settings → Channel secret；Messaging API → Channel access token (long-lived)）
LINE_MESSAGING_CHANNEL_SECRET=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
# 官方帳號 Basic ID（含 @，例如 @123abcde）。選填：加好友彈窗無法使用時的備用連結
LINE_OA_BASIC_ID=

# 沒有常駐 qcluster 的環境（Fly.io scale-to-zero）設為 True，背景任務改為同步執行
TASKS_SYNC=False
